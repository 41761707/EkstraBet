# Szablon zmiennych środowiskowych frontendu Next.js.
# Skopiuj do `frontend/.env.local` (lokalnie) albo na VPS do pliku env frontendu
# w `/etc/ekstrabet/` (radikey:radikey, 0600) i uzupełnij prawdziwe wartości.
# Komentarze są tylko dokumentacją - docelowy plik env powinien mieć same KEY=value.

# ================================
# ENVIRONMENT
# ================================
# development | production | test
# production: fail-closed - brak APP_ORIGIN / API_BASE_URL albo AUTH_ENABLED=false
# blokuje start (instrumentation.ts).
ENVIRONMENT=development
# Publiczny origin aplikacji (kontrola Origin dla mutujących żądań BFF)
# production: https://twoja-domena (bez końcowego /).
# Compose: compose.production.yml wymaga APP_ORIGIN w env projektu Compose
# (shell albo plik .env obok compose) przez ${APP_ORIGIN:?...} - sam wpis
# w frontend.env nie wystarczy do przejścia interpolacji.
APP_ORIGIN=http://localhost:3000
# Musi być zgodne z backendowym AUTH_ENABLED (tylko serwer - bez NEXT_PUBLIC_)
AUTH_ENABLED=true
AUTH_COOKIE_NAME=ekstrabet_token

# ================================
# TIMEZONE
# ================================
# Daty meczów są naiwnym czasem polskim. Serwer Next.js musi używać Warsaw.
TZ=Europe/Warsaw

# ================================
# API URLS
# ================================
# Adres FastAPI używany przez BFF / RSC / chat (tylko serwer)
# local: http://localhost:8000; production Compose: http://api:8000
API_BASE_URL=http://localhost:8000
# TYLKO lokalny development. W production NIE ustawiać tej zmiennej -
# klient przeglądarkowy chodzi wyłącznie przez BFF (/api/backend/...),
# a start z ENVIRONMENT=production + NEXT_PUBLIC_API_BASE_URL kończy się błędem.
# NEXT_PUBLIC_API_BASE_URL=http://localhost:8000

# ================================
# CHAT
# ================================
# openrouter (docelowo) | cursor (prototyp)
CHAT_PROVIDER=openrouter
NEXT_PUBLIC_CHAT_DEFAULT_PROVIDER=openrouter
# W production trzymać false, dopóki nie zatwierdzono limitów kosztów
CHAT_ENABLE_CURSOR=false
NEXT_PUBLIC_CHAT_ENABLE_CURSOR=false

# Rate limit: in-memory per Node process (NOT shared across workers/replicas).
# Prefer session cookie key; IP fallback; ip:unknown shares one bucket.
# For multi-instance production, replace with a shared store (e.g. Redis).
CHAT_RATE_LIMIT_WINDOW_MS=60000
CHAT_RATE_LIMIT_MAX_REQUESTS=20

# ================================
# OPENROUTER
# ================================
OPENROUTER_API_KEY=sk-or-v1-xxx
OPENROUTER_MODEL=openai/gpt-4o-mini
# Optional OpenRouter attribution headers
# OPENROUTER_HTTP_REFERER=https://ekstrabet.example
# OPENROUTER_APP_TITLE=EkstraBet Chat

# ================================
# CURSOR SDK (local prototype)
# ================================
CURSOR_API_KEY=cursor_xxx
CURSOR_MODEL=composer-2.5

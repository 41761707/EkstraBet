# Szablon sekretów usługi MySQL w Docker Compose (SZP-70).
# Skopiuj do /etc/ekstrabet/mysql.env (właściciel radikey:radikey, tryb 0600).
# Docelowy plik powinien mieć same linie KEY=value — bez komentarzy.
#
# Tylko zmienne obrazu mysql:8.x. NIE umieszczaj tu JWT, haseł API ani frontendu.
# Konta aplikacji (ekstrabet_api / model / backup) zakłada operator ręcznie
# w MySQL — ich hasła trafiają do api.env / skryptów backupu, nie tutaj.

MYSQL_ROOT_PASSWORD=change_me_strong_root_password_for_mysql_container
MYSQL_DATABASE=ekstrabet

# Szablon konfiguracji syncu lokal -> produkcja (SZP-21).
# Skopiuj do pliku poza Git (np. %USERPROFILE%\.ekstrabet\sync.env) i uzupelnij.
# Lokalne DB_* zwykle biora sie z .env w katalogu repo.

# ================================
# TRANSPORT
# ================================
# ssh = lokalny mysqldump/select + zdalny docker compose exec mysql (domyslne)
# direct = bezposrednie polaczenie do PROD_DB_* (np. tunel SSH -L)
SYNC_TRANSPORT=ssh

# ================================
# SSH + Compose (transport=ssh)
# ================================
SYNC_SSH_HOST=radikey@YOUR_VPS_IP
SYNC_REMOTE_REPO=/path/to/EkstraBet
SYNC_COMPOSE_FILE=compose.production.yml
SYNC_MYSQL_SERVICE=mysql
# Plik na VPS z MYSQL_ROOT_PASSWORD / MYSQL_DATABASE
SYNC_REMOTE_MYSQL_ENV=/etc/ekstrabet/mysql.env

# ================================
# DIRECT (transport=direct)
# ================================
# PROD_DB_HOST=127.0.0.1
# PROD_DB_PORT=3307
# PROD_DB_USER=ekstrabet_sync
# PROD_DB_PASSWORD=change_me
# PROD_DB_NAME=ekstrabet

# ================================
# SYNC POLICY
# ================================
# Okno mutowalnych meczow (domyslnie 3 dni, zgodnie z ustaleniem)
SYNC_WINDOW_DAYS=3
# Rozmiar batcha INSERT ... ON DUPLICATE KEY UPDATE
SYNC_BATCH_SIZE=200

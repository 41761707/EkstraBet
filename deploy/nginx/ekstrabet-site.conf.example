# EkstraBet — prosty reverse proxy do Next.js na 127.0.0.1:3000 (compose.production.yml).
#
# Instalacja:
#   sudo cp deploy/nginx/ekstrabet-site.conf.example /etc/nginx/sites-available/ekstrabet
#   sudo ln -sf /etc/nginx/sites-available/ekstrabet /etc/nginx/sites-enabled/ekstrabet
#   sudo nginx -t && sudo systemctl reload nginx
#
# Cloudflare: wystarczy tryb Full (strict) + cert na origin. Osobna konfiguracja CF w nginx nie jest wymagana.

# HTTP → HTTPS
server {
    listen 80;
    listen [::]:80;
    server_name radikey.pl www.radikey.pl;

    return 301 https://$host$request_uri;
}

server {
    listen 443 ssl;
    listen [::]:443 ssl;
    server_name radikey.pl www.radikey.pl;

    ssl_certificate     /etc/ssl/radikey.pl.crt;
    ssl_certificate_key /etc/ssl/private/radikey.pl.key;

    client_max_body_size 1m;

    location / {
        proxy_pass http://127.0.0.1:3000;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        # Next.js RSC streamuje odpowiedzi — buffering psuje client navigation
        proxy_buffering off;
        proxy_read_timeout 60s;
    }
}

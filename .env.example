# Szablon zmiennych środowiskowych EkstraBet (API / backend).
# Skopiuj do `.env` (lokalnie) albo na VPS do `/etc/ekstrabet/` (tryb 0640,
# właściciel root:ekstrabet) i uzupełnij prawdziwe wartości.
# Komentarze są tylko dokumentacją — docelowy plik env powinien mieć same KEY=value.
# Nie commituj sekretów. Nie wklejaj ich do obrazów Docker.

# ================================
# ENVIRONMENT
# ================================
# development | production | test
# production włącza walidację fail-closed (SECRET_KEY, AUTH, CORS, DB_USER, …)
ENVIRONMENT=development
DEBUG=false
# OpenAPI (/docs, /redoc, /openapi.json) — w production musi być false
OPENAPI_ENABLED=false

# ================================
# DATABASE (REQUIRED)
# ================================
# local: localhost + własne konto; production: host usługi Compose (np. mysql)
# oraz konto nie-root (np. ekstrabet_api) — DB_USER=root w production jest odrzucane
DB_HOST=localhost
DB_USER=guestuser
DB_PASSWORD=your_database_password
DB_NAME=ekstrabet
DB_PORT=3306

# ================================
# DATABASE BACKUP
# ================================
# Absolute path or path relative to the repository root
BACKUP_DIR=backups

# ================================
# API
# ================================
API_TITLE=EkstraBet API
API_DESCRIPTION=EkstraBet API for managing sports data
API_VERSION=1.0.0

# ================================
# SERVER
# ================================
HOST=0.0.0.0
PORT=8000

# ================================
# PAGINATION
# ================================
DEFAULT_PAGE_SIZE=50
MAX_PAGE_SIZE=500

# ================================
# LOGGING
# ================================
LOG_LEVEL=INFO

# ================================
# CORS / HOSTS
# ================================
# local: http://localhost:3000; production: publiczny origin HTTPS aplikacji
FRONTEND_ORIGIN=http://localhost:3000
# JSON list — dozwolone originy CORS (nie zwykły string; nie używaj * w production)
CORS_ORIGINS=["http://localhost:3000","http://localhost:8000"]
# JSON list — dozwolone metody HTTP
CORS_METHODS=["GET","POST","PUT","DELETE"]
# JSON list — dozwolone wartości nagłówka Host (* tylko poza production)
TRUSTED_HOSTS=["localhost","127.0.0.1"]

# ================================
# AUTHENTICATION (REQUIRED)
# ================================
# Losowy sekret ≥ 32 znaków; w production odrzucane są placeholdery i krótkie wartości
SECRET_KEY=generate_a_strong_random_key_at_least_32_chars
# local może być dłuższy; production: 30 minut
ACCESS_TOKEN_EXPIRE_MINUTES=30
# w production musi pozostać true — false blokuje start
AUTH_ENABLED=true
AUTH_COOKIE_NAME=ekstrabet_token

# ================================
# CACHE / OPTIONAL FEATURES
# ================================
CACHE_TTL=300
ENABLE_CACHE=false
# Trzymać wyłączone, dopóki nie zatwierdzono limitów zasobów
EKSTRABET_ML_PREVIEW=false
